# انسخه إلى deploy/vps/.env على الخادم (chmod 600) واملأ القيم.
# القيم نفسها التي في بيئة خدمة Render (Environment) ما لم يُذكر غير ذلك.

# ---- قاعدة البيانات (جديدة على الخادم) — كلمة طويلة عشوائية:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=

# ---- Django — انسخ من Render
SECRET_KEY=
ALLOWED_HOSTS=stingdev.pro,www.stingdev.pro,localhost,127.0.0.1
FRONTEND_URL=https://stingdev.pro
# بدونه يرفض Django كل حفظ من اللوحة بـ 403 (Origin checking failed) — كان
# مضبوطًا في بيئة Render ولم يُنسخ عند الانتقال أول مرة
CSRF_TRUSTED_ORIGINS=https://stingdev.pro,https://www.stingdev.pro,https://stingdev.57-129-162-57.sslip.io
# سرّ إبطال الصفحات بين Django وNext — ثابت خير من سرّ جديد لكل إقلاع
REVALIDATE_SECRET=

# ---- الكوكيز — انسخ من Render. أثناء التجربة على عنوان sslip.io اترك
#      COOKIE_DOMAIN فارغًا وإلا لن يعمل تسجيل الدخول هناك
COOKIE_DOMAIN=
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax

# ---- البريد — انسخ من Render
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ---- اختياري
# APP_PORT=3200        # منفذ 127.0.0.1 الذي يوجّه إليه Caddy — سجّله في /srv/apps/PORTS.md
# IMAGE_TAG=latest     # أو sha-<commit> للرجوع إلى نسخة سابقة
