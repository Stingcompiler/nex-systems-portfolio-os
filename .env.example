# ===============================================================
#  إعدادات منصة stingdev — ملف واحد للطرفين
# ---------------------------------------------------------------
#  انسخه إلى .env في جذر المشروع:  python run.py setup
#
#  الخلفية تقرأ كل المتغيرات.
#  الواجهة تقرأ قائمة محددة فقط (انظر FRONTEND_ENV_KEYS في
#  frontend/next.config.mjs) — أسرار الخلفية لا تدخل عملية Node إطلاقًا.
# ===============================================================

# ---------------------------------------------------------------- عام
DJANGO_SETTINGS_MODULE=config.settings.dev
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# 50 حرفًا على الأقل. توليد مفتاح إنتاج:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-key-replace-before-any-deployment-0123456789

# ---------------------------------------------------------------- قاعدة البيانات
# sqlite | postgres
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------------------------------------------------------------- المنافذ
API_PORT=8000
WEB_PORT=3000

# ---------------------------------------------------------------- الرموز والكوكيز
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7
COOKIE_SECURE=False
COOKIE_DOMAIN=
COOKIE_SAMESITE=Lax
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- البريد
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=stingdev <no-reply@localhost>

EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_HOURS=2

# ---------------------------------------------------------------- الوسائط
MAX_UPLOAD_SIZE_MB=10

# ---------------------------------------------------------------- الربط بين الطرفين
# عنوان الموقع العام — canonical و sitemap و Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# اتصال خادم Next بـ Django مباشرة (داخلي، لا يمر بالمتصفح)
INTERNAL_API_URL=http://127.0.0.1:8000/api/v1
BACKEND_ORIGIN=http://127.0.0.1:8000

# ما يراه المتصفح — نسبي دائمًا، فلا يعرف عنوان Django
NEXT_PUBLIC_API_URL=/api/v1

# سر مشترك لإبطال التخزين المؤقت من لوحة التحكم
REVALIDATE_SECRET=change-me

# ---------------------------------------------------------------- الواجهة الأمامية للخلفية
FRONTEND_URL=http://localhost:3000
