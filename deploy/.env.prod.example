# ─── NEXA SYSTEMS — Production env vars (stingdev.pro) ──────
#
# These are set in the Render Dashboard (or via render.yaml).
# The database vars are auto-filled from the Render PostgreSQL addon.
#
# After your first deploy, set INTERNAL_API_URL and BACKEND_ORIGIN
# on the nexa-web service with your Render API service URL.
# ─────────────────────────────────────────────────────────────

DJANGO_SETTINGS_MODULE=config.settings.prod

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False

ALLOWED_HOSTS=stingdev.pro,www.stingdev.pro,.onrender.com
CSRF_TRUSTED_ORIGINS=https://stingdev.pro,https://www.stingdev.pro

# Database — auto-filled by Render PostgreSQL
DB_ENGINE=postgres
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Cookies
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=True

# Email — switch to SMTP for production
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=NEXA SYSTEMS <no-reply@stingdev.pro>

# Frontend
FRONTEND_URL=https://stingdev.pro
REVALIDATE_SECRET=

# ─── Next.js env vars (set on the nexa-web service) ─────────

NEXT_PUBLIC_SITE_URL=https://stingdev.pro
NEXT_PUBLIC_API_URL=/api/v1

# Set these after deploy — use your Render API service URL
INTERNAL_API_URL=https://nexa-api.onrender.com/api/v1
BACKEND_ORIGIN=https://nexa-api.onrender.com
