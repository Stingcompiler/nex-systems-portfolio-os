[Unit]
Description=stingdev Next.js frontend
After=network.target stingdev-api.service

[Service]
Type=simple
User=stingdev
Group=stingdev
WorkingDirectory=/srv/stingdev/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/srv/stingdev/.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
